{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/foundata/conclear/schemas/provenance-v1.json",
  "title": "ConClear SLSA Provenance v1 statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subject"}},
    "predicateType": {"const": "https://slsa.dev/provenance/v1"},
    "predicate": {"$ref": "#/$defs/predicate"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "digest": {"type": "object", "additionalProperties": false, "required": ["sha256"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}}}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "digest": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildDefinition", "runDetails"],
      "properties": {
        "buildDefinition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["buildType", "externalParameters", "internalParameters", "resolvedDependencies"],
          "properties": {
            "buildType": {"const": "https://github.com/foundata/conclear/build/v1"},
            "externalParameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["imageId", "version", "runId", "platforms"],
              "properties": {
                "imageId": {"type": "string", "minLength": 1},
                "version": {"type": ["string", "null"]},
                "runId": {"type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"},
                "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
              }
            },
            "internalParameters": {"type": "object", "maxProperties": 0},
            "resolvedDependencies": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/dependency"}}
          }
        },
        "runDetails": {
          "type": "object",
          "additionalProperties": false,
          "required": ["builder", "metadata", "byproducts"],
          "properties": {
            "builder": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "string", "pattern": "^https://github\\.com/foundata/conclear/commit/[0-9a-f]{40,64}$"}}},
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": ["invocationId", "startedOn", "finishedOn"],
              "properties": {
                "invocationId": {"type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"},
                "startedOn": {"$ref": "#/$defs/timestamp"},
                "finishedOn": {"$ref": "#/$defs/timestamp"}
              }
            },
            "byproducts": {"type": "array", "maxItems": 0}
          }
        }
      }
    }
  }
}
