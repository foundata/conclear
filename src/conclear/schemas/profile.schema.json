{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/foundata/conclear/schemas/profile-v1.json",
  "title": "ConClear maintainer release profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ci_context",
    "builder",
    "registry",
    "cosign_public_key",
    "allowed_source_origins"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "allowed_source_origins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[^\\s?#]+/$"
      }
    },
    "ci_context": {
      "enum": [
        "omit",
        "observe",
        "require"
      ]
    },
    "builder": {
      "$ref": "#/$defs/builder"
    },
    "auth_file": {
      "type": "string",
      "minLength": 1
    },
    "registry": {
      "$ref": "#/$defs/registry"
    },
    "cosign_private_key": {
      "type": "string",
      "minLength": 1
    },
    "cosign_public_key": {
      "type": "string",
      "minLength": 1
    },
    "passphrase_file": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^https://[^\\s?#]+$"
        }
      }
    },
    "registry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "host",
            "tag_protection",
            "candidate_cleanup"
          ],
          "properties": {
            "tag_protection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": {
                "mode": {"enum": ["required", "not-enforced"]},
                "rationale": {"type": "string", "pattern": "\\S"},
                "owner": {"type": "string", "pattern": "\\S"}
              },
              "if": {"properties": {"mode": {"const": "not-enforced"}}},
              "then": {"required": ["rationale", "owner"]},
              "else": {"not": {"anyOf": [{"required": ["rationale"]}, {"required": ["owner"]}]}}
            },
            "candidate_cleanup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "owner", "procedure"],
              "properties": {
                "mode": {"enum": ["manual", "tag-expiration", "auto-prune"]},
                "owner": {"type": "string", "pattern": "\\S"},
                "procedure": {"type": "string", "pattern": "\\S"}
              }
            },
            "provider": {
              "const": "quay"
            },
            "host": {
              "const": "quay.io"
            },
            "api_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "token_file": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
