{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/foundata/conclear/schemas/profile-v1.json",
  "title": "ConClear maintainer release profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["ci_context", "builder", "registry", "cosign_public_key"],
  "properties": {
    "ci_context": {"enum": ["omit", "observe", "require"]},
    "builder": {"$ref": "#/$defs/builder"},
    "auth_file": {"type": "string", "minLength": 1},
    "registry": {"$ref": "#/$defs/registry"},
    "cosign_private_key": {"type": "string", "minLength": 1},
    "cosign_public_key": {"type": "string", "minLength": 1},
    "passphrase_file": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^https://[^\\s?#]+$"}
      }
    },
    "registry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "host"],
          "properties": {
            "provider": {"const": "quay"},
            "host": {"const": "quay.io"},
            "api_url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "token_file": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
