{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/foundata/conclear/schemas/profile-v1.json",
  "title": "ConClear maintainer release profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "cosign_public_key"],
  "properties": {
    "mode": {"enum": ["local", "ci"]},
    "auth_file": {"type": "string", "minLength": 1},
    "quay_token_file": {"type": "string", "minLength": 1},
    "cosign_private_key": {"type": "string", "minLength": 1},
    "cosign_public_key": {"type": "string", "minLength": 1},
    "passphrase_file": {"type": "string", "minLength": 1},
    "quay_api_url": {"type": "string", "format": "uri", "pattern": "^https://"}
  }
}
