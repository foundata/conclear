{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/foundata/conclear/schemas/record.json",
  "title": "ConClear public record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "createdAt", "runId", "ruleset", "source", "repositoryConfiguration", "tools", "verdict", "payload"],
  "properties": {
    "schemaVersion": {"type": "integer", "minimum": 1},
    "recordType": {"enum": ["platformQualification", "qualificationTransport", "releaseCandidate", "releaseVerification", "rescanResult"]},
    "createdAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "runId": {"type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"},
    "ruleset": {"$ref": "#/$defs/ruleset"},
    "source": {"$ref": "#/$defs/source"},
    "repositoryConfiguration": {"$ref": "#/$defs/configuration"},
    "tools": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tool"}},
    "verdict": {"enum": ["accepted", "rejected", "incomplete"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"recordType": {"const": "platformQualification"}}}, "then": {"properties": {"schemaVersion": {"const": 1}, "payload": {"$ref": "#/$defs/platformQualification"}}}},
    {"if": {"properties": {"recordType": {"const": "qualificationTransport"}}}, "then": {"properties": {"schemaVersion": {"const": 1}, "payload": {"$ref": "#/$defs/qualificationTransport"}}}},
    {"if": {"properties": {"recordType": {"const": "releaseCandidate"}}}, "then": {"properties": {"schemaVersion": {"const": 1}, "payload": {"$ref": "#/$defs/releaseCandidate"}}}},
    {"if": {"properties": {"recordType": {"const": "releaseVerification"}}}, "then": {"properties": {"schemaVersion": {"const": 1}, "payload": {"$ref": "#/$defs/releaseVerification"}}}},
    {"if": {"properties": {"recordType": {"const": "rescanResult"}}}, "then": {"properties": {"schemaVersion": {"const": 1}, "payload": {"$ref": "#/$defs/rescanResult"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "platform": {"type": "string", "pattern": "^[a-z0-9._-]+/[a-z0-9._-]+(?:/[a-z0-9._-]+)?$"},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "digestArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "databaseComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "updatedAt", "nextUpdate", "downloadedAt"],
      "properties": {
        "schemaVersion": {"type": "integer", "minimum": 1},
        "updatedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "nextUpdate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "downloadedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    },
    "databaseMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vulnerability", "java"],
      "properties": {
        "vulnerability": {"$ref": "#/$defs/databaseComponent"},
        "java": {"$ref": "#/$defs/databaseComponent"}
      }
    },
    "rescanFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "checkId", "severity", "message"],
      "properties": {
        "platform": {"$ref": "#/$defs/platform"},
        "checkId": {"type": "string", "pattern": "^CC[0-9]{4}$"},
        "severity": {"enum": ["error", "warning", "info"]},
        "message": {"type": "string", "minLength": 1},
        "location": {"type": "string"}
      }
    },
    "rescanAppliedException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "image", "component", "advisory", "expires"],
      "properties": {
        "platform": {"$ref": "#/$defs/platform"},
        "image": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "advisory": {"type": "string", "minLength": 1},
        "expires": {"type": "string", "format": "date"}
      }
    },
    "remediationFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "component", "advisory", "startedAt", "deadline", "overdue"],
      "properties": {
        "platform": {"$ref": "#/$defs/platform"},
        "component": {"type": "string", "minLength": 1},
        "advisory": {"type": "string", "minLength": 1},
        "startedAt": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "deadline": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "overdue": {"type": "boolean"}
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limitSeconds", "findings"],
      "properties": {
        "limitSeconds": {"type": "integer", "minimum": 1, "maximum": 2592000},
        "findings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/remediationFinding"}}
      }
    },
    "triageDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "platform", "component", "advisory", "decision", "rationale", "owner", "decidedAt", "remediatingDigest"],
      "properties": {
        "subject": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
        "platform": {"$ref": "#/$defs/platform"},
        "component": {"type": "string", "minLength": 1},
        "advisory": {"type": "string", "minLength": 1},
        "decision": {"enum": ["affected", "not-applicable", "remediation-planned", "remediated"]},
        "rationale": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "decidedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "remediatingDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "remediated"}}, "required": ["decision"]},
          "then": {"properties": {"remediatingDigest": {"$ref": "#/$defs/digest"}}},
          "else": {"properties": {"remediatingDigest": {"type": "null"}}}
        }
      ]
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclearVersion", "conclearRevision", "guideTitle", "guideRepository", "guidePath", "guideRevision"],
      "properties": {
        "conclearVersion": {"type": "string"},
        "conclearRevision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "guideTitle": {"const": "OCI container image build and release guide"},
        "guideRepository": {"const": "https://github.com/foundata/guidelines"},
        "guidePath": {"const": "oci-container-image-guide.md"},
        "guideRevision": {"const": "b179c89cd51f79cdb7f6d713a3e260b781b8b121"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "pattern": "^https://"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"const": "conclear.toml"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "executableDigest": {"$ref": "#/$defs/digest"},
        "imageDigest": {"$ref": "#/$defs/digest"}
      },
      "oneOf": [
        {"required": ["executableDigest"]},
        {"required": ["imageDigest"]}
      ]
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "digest", "size"],
      "properties": {
        "mediaType": {"type": "string"},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0},
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "architecture"],
          "properties": {
            "os": {"type": "string", "minLength": 1},
            "architecture": {"type": "string", "minLength": 1},
            "variant": {"type": "string", "minLength": 1}
          }
        },
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetPlatform", "hostArchitecture", "executionArchitecture", "mechanism"],
      "properties": {
        "targetPlatform": {"$ref": "#/$defs/platform"},
        "hostArchitecture": {"type": "string"},
        "executionArchitecture": {"type": "string"},
        "mechanism": {"enum": ["native", "qemu-user", "cross-build"]}
      }
    },
    "runtimeRequirement": {
      "type": "object", "additionalProperties": false,
      "required": ["rationale", "owner", "reviewTrigger"],
      "properties": {
        "rationale": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "reviewTrigger": {"type": "string", "minLength": 1}
      }
    },
    "runtimeConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "user", "readOnly", "writableMounts", "memory", "cpus", "pids", "nofile", "capabilities"],
      "properties": {
        "profile": {"enum": ["service", "one-shot", "scratch", "systemd"]},
        "user": {"type": "integer", "minimum": 0},
        "readOnly": {"type": "boolean"},
        "noNewPrivileges": {"type": "boolean"},
        "writableRootRequirement": {"$ref": "#/$defs/runtimeRequirement"},
        "sudoRequirement": {
          "type": "object", "additionalProperties": false,
          "required": ["rationale", "owner", "reviewTrigger", "mode", "scope", "setidPaths"],
          "properties": {
            "rationale": {"type": "string", "minLength": 1},
            "owner": {"type": "string", "minLength": 1},
            "reviewTrigger": {"type": "string", "minLength": 1},
            "mode": {"enum": ["presence-only", "escalation"]},
            "scope": {"type": "string", "minLength": 1},
            "setidPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          }
        },
        "setidRequirements": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "rationale", "owner", "reviewTrigger"],
            "properties": {
              "path": {"type": "string"},
              "rationale": {"type": "string", "minLength": 1},
              "owner": {"type": "string", "minLength": 1},
              "reviewTrigger": {"type": "string", "minLength": 1}
            }
          }
        },
        "writableMounts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "memory": {"type": "string", "pattern": "^[1-9][0-9]*(?:KiB|MiB|GiB)$"},
        "cpus": {"type": "number", "exclusiveMinimum": 0},
        "pids": {"type": "integer", "minimum": 1},
        "nofile": {"type": "integer", "minimum": 1},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "rootRequirement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rationale", "owner", "reviewTrigger"],
          "properties": {
            "rationale": {"type": "string", "minLength": 1},
            "owner": {"type": "string", "minLength": 1},
            "reviewTrigger": {"type": "string", "minLength": 1}
          }
        },
        "systemd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredUnits", "stopSignal"],
          "properties": {
            "requiredUnits": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "stopSignal": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"readOnly": {"const": false}}, "required": ["readOnly"]},
          "then": {"required": ["writableRootRequirement"]},
          "else": {"not": {"required": ["writableRootRequirement"]}}
        },
        {
          "if": {"properties": {"noNewPrivileges": {"const": false}}, "required": ["noNewPrivileges"]},
          "then": {"required": ["sudoRequirement"], "properties": {"sudoRequirement": {"properties": {"mode": {"const": "escalation"}}}}}
        },
        {
          "if": {"required": ["sudoRequirement"], "properties": {"sudoRequirement": {"required": ["mode"], "properties": {"mode": {"const": "escalation"}}}}},
          "then": {"required": ["noNewPrivileges"], "properties": {"noNewPrivileges": {"const": false}}},
          "else": {"properties": {"noNewPrivileges": {"const": true}}}
        },
        {
          "if": {"properties": {"user": {"const": 0}}, "required": ["user"]},
          "then": {"required": ["rootRequirement"]},
          "else": {"not": {"required": ["rootRequirement"]}}
        },
        {
          "if": {"properties": {"profile": {"const": "systemd"}}, "required": ["profile"]},
          "then": {"required": ["systemd"], "properties": {"user": {"const": 0}}},
          "else": {"not": {"required": ["systemd"]}}
        }
      ]
    },
    "runtimeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "readOnly", "writableMounts", "memoryBytes", "nanoCpus", "pidsLimit", "nofile", "capAdd", "capDrop", "effectiveCapabilities", "securityOptions", "userNamespace", "cgroupNamespace", "privileged", "stopSignal"],
      "properties": {
        "user": {"type": "string"},
        "readOnly": {"type": "boolean"},
        "writableMounts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "memoryBytes": {"type": "integer"},
        "nanoCpus": {"type": "integer"},
        "pidsLimit": {"type": "integer"},
        "nofile": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "items": false},
        "capAdd": {"$ref": "#/$defs/stringArray"},
        "capDrop": {"$ref": "#/$defs/stringArray"},
        "boundingCapabilities": {"$ref": "#/$defs/stringArray"},
        "effectiveCapabilities": {"$ref": "#/$defs/stringArray"},
        "securityOptions": {"$ref": "#/$defs/stringArray"},
        "userNamespace": {"const": "private"},
        "cgroupNamespace": {"const": "private"},
        "privileged": {"const": false},
        "stopSignal": {"type": "string", "minLength": 1}
      }
    },
    "setidObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "resolvedPath", "owner", "mode"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "resolvedPath": {"type": "string", "pattern": "^/"},
        "owner": {"const": 0},
        "mode": {"type": "string", "pattern": "^0o[0-7]{3,4}$"}
      }
    },
    "sudoTestResult": {
      "type": "object", "additionalProperties": false,
      "required": ["user", "targetUser", "command", "expected", "status", "exitStatus", "stdout", "stderr", "noNewPrivileges"],
      "properties": {
        "name": {"const": "sudoAuthorization"},
        "user": {"type": "integer", "minimum": 0},
        "policyUser": {"type": "integer", "minimum": 1},
        "targetUser": {"type": "integer", "minimum": 0},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expected": {"enum": ["success", "denied"]},
        "status": {"enum": ["passed", "failed"]},
        "exitStatus": {"type": "integer", "minimum": 0},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "noNewPrivileges": {"type": "boolean"}
      },
      "allOf": [{
        "if": {"required": ["name"], "properties": {"name": {"const": "sudoAuthorization"}}},
        "then": {"required": ["policyUser"], "properties": {"user": {"const": 0}}},
        "else": {"properties": {"user": {"minimum": 1}}, "not": {"required": ["policyUser"]}}
      }]
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "dependentRequired": {
        "outcome": ["attempts", "elapsedSeconds", "timeoutSeconds", "containerStatus", "containerExitStatus", "outputDigest"]
      },
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "skipped"]},
        "digest": {"$ref": "#/$defs/digest"},
        "observed": {"$ref": "#/$defs/runtimeObservation"},
        "setidExecutables": {"type": "array", "items": {"$ref": "#/$defs/setidObservation"}},
        "sudoExecutable": {"type": "string", "pattern": "^/"},
        "sudoPolicy": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^/"}, "additionalProperties": {"type": "string"}},
        "sudoPolicyDigest": {"$ref": "#/$defs/digest"},
        "sudoTests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sudoTestResult"}},
        "exitStatus": {"type": "integer"},
        "peakMemoryBytes": {"type": "integer", "minimum": 0},
        "peakPids": {"type": "integer", "minimum": 0},
        "openFiles": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["ready", "timeout", "exited"]},
        "attempts": {"type": "integer", "minimum": 0},
        "elapsedSeconds": {"type": "number", "minimum": 0},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "containerStatus": {"type": "string", "minLength": 1},
        "containerExitStatus": {"type": ["integer", "null"]},
        "required": {"type": "boolean"},
        "executable": {"type": ["string", "null"]},
        "executableDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "outputDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "testMountDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "name", "target", "readOnly"],
      "properties": {
        "source": {"enum": ["fixture", "output"]},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "target": {"type": "string", "pattern": "^/"},
        "readOnly": {"type": "boolean"}
      }
    },
    "testInputTree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "secret", "files", "bytes"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "secret": {"type": "boolean"},
        "files": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {"properties": {"secret": {"const": false}}, "required": ["secret"]},
          "then": {"required": ["digest"]},
          "else": {"not": {"required": ["digest"]}}
        }
      ]
    },
    "testPreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "imageId", "commandDigest", "environmentDigest", "mounts", "timeoutSeconds", "expectedExitStatus", "imageManifestDigest"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "imageId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "commandDigest": {"$ref": "#/$defs/digest"},
        "environmentDigest": {"$ref": "#/$defs/digest"},
        "mounts": {"type": "array", "items": {"$ref": "#/$defs/testMountDeclaration"}},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "expectedExitStatus": {"type": "integer", "minimum": 0, "maximum": 255},
        "imageManifestDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "testLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argumentsDigest", "environmentDigest", "mounts", "expectedExitStatus"],
      "properties": {
        "argumentsDigest": {"$ref": "#/$defs/digest"},
        "environmentDigest": {"$ref": "#/$defs/digest"},
        "mounts": {"type": "array", "items": {"$ref": "#/$defs/testMountDeclaration"}},
        "expectedExitStatus": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "testInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtures", "outputs", "preparations", "launch"],
      "properties": {
        "fixtures": {"type": "array", "items": {"$ref": "#/$defs/testInputTree"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/testInputTree"}},
        "preparations": {"type": "array", "items": {"$ref": "#/$defs/testPreparation"}},
        "launch": {"$ref": "#/$defs/testLaunch"}
      }
    },
    "testImageDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageId", "platform", "manifestDigest", "layoutDescriptor", "sourceRevision", "containerfileDigest", "contextDigest", "buildArguments", "externalImages", "pinObservations", "effectiveLimits", "testResultDigest"],
      "properties": {
        "imageId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "platform": {"$ref": "#/$defs/platform"},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "layoutDescriptor": {"$ref": "#/$defs/descriptor"},
        "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "containerfileDigest": {"$ref": "#/$defs/digest"},
        "contextDigest": {"$ref": "#/$defs/digest"},
        "buildArguments": {"$ref": "#/$defs/buildArguments"},
        "externalImages": {"type": "array", "items": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}},
        "pinObservations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/pinObservation"}},
        "effectiveLimits": {"$ref": "#/$defs/effectiveLimits"},
        "testResultDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "packageAssessment": {
      "description": "Whether the scanner assessed the operating-system packages it inventoried. Records written before ConClear evaluated scanner coverage omit it; absence means not evaluated, never assessed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "operatingSystem", "packages", "reason", "exception"],
      "properties": {
        "status": {"enum": ["assessed", "unassessed"]},
        "operatingSystem": {"type": ["string", "null"], "minLength": 1},
        "packages": {"type": "integer", "minimum": 0},
        "reason": {"type": ["string", "null"], "minLength": 1},
        "exception": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["rationale", "owner", "reviewTrigger", "expires"],
          "properties": {
            "rationale": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1},
            "reviewTrigger": {"type": "string", "minLength": 1}, "expires": {"type": "string", "format": "date"}
          }
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "path"],
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "path": {"type": "string", "pattern": "^[^/\\\\]+$"}
      }
    },
    "appliedConfigurationException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "path", "checks", "target", "check", "expires"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "checks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "target": {"type": "string", "minLength": 1},
        "check": {"type": "string", "minLength": 1},
        "expires": {"type": "string", "format": "date"}
      }
    },
    "rescanAppliedConfigurationException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "image", "path", "checks", "target", "check", "expires"],
      "properties": {
        "platform": {"$ref": "#/$defs/platform"},
        "image": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "checks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "target": {"type": "string", "minLength": 1},
        "check": {"type": "string", "minLength": 1},
        "expires": {"type": "string", "format": "date"}
      }
    },
    "appliedException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "component", "advisory", "expires"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "advisory": {"type": "string", "minLength": 1},
        "expires": {"type": "string", "format": "date"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "severity", "message"],
      "properties": {
        "checkId": {"type": "string", "pattern": "^CC[0-9]{4}$"},
        "severity": {"enum": ["error", "warning", "info"]},
        "message": {"type": "string", "minLength": 1},
        "location": {"type": "string"},
        "image": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"}
      }
    },
    "buildArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["IMAGE_REVISION", "IMAGE_CREATED", "SOURCE_DATE_EPOCH"],
      "properties": {
        "IMAGE_REVISION": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "IMAGE_CREATED": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "SOURCE_DATE_EPOCH": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "IMAGE_VERSION": {"type": "string", "minLength": 1}
      }
    },
    "pinObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "pinnedDigest", "observedDigest", "checkedAt", "divergenceSince", "historyInitialized", "findings"],
      "properties": {
        "reference": {"type": "string", "pattern": "^[^@\\s]+:[^@\\s]+@sha256:[0-9a-f]{64}$"},
        "pinnedDigest": {"$ref": "#/$defs/digest"},
        "observedDigest": {"$ref": "#/$defs/digest"},
        "checkedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "divergenceSince": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "historyInitialized": {"type": "boolean"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "effectiveLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pinFreshnessSeconds", "pinDivergenceSeconds"],
      "properties": {
        "pinFreshnessSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "pinDivergenceSeconds": {"type": "integer", "minimum": 1, "maximum": 604800}
      }
    },
    "ciContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source", "repository", "revision", "runId"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "source": {"const": "provider-environment"},
        "repository": {"type": "string", "pattern": "^(?!.*\\.git$)[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "runId": {"type": "string", "pattern": "^\\S{1,1024}$"}
      }
    },
    "builderIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^https://[^\\s?#]+$"}
      }
    },
    "qualificationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "expiresAt"],
      "properties": {
        "startedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "expiresAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    },
    "platformQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageId", "sourceTreeDigest", "platform", "layoutDescriptor", "manifestDigest", "containerfileDigest", "contextDigest", "buildArguments", "externalImages", "pinObservations", "effectiveLimits", "buildExecution", "testExecution", "runtimeConstraints", "testInputs", "testImageDependencies", "testResults", "sbom", "scans", "appliedExceptions", "payloadDigests", "databaseDigest", "databaseMetadata", "qualificationWindow", "findings"],
      "properties": {
        "sourceTreeDigest": {"$ref": "#/$defs/digest"},
        "imageId": {"type": "string"},
        "platform": {"$ref": "#/$defs/platform"},
        "layoutDescriptor": {"$ref": "#/$defs/descriptor"},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "containerfileDigest": {"$ref": "#/$defs/digest"},
        "contextDigest": {"$ref": "#/$defs/digest"},
        "buildArguments": {"$ref": "#/$defs/buildArguments"},
        "externalImages": {"type": "array", "items": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}},
        "pinObservations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/pinObservation"}},
        "effectiveLimits": {"$ref": "#/$defs/effectiveLimits"},
        "buildExecution": {"$ref": "#/$defs/execution"},
        "testExecution": {"$ref": "#/$defs/execution"},
        "runtimeConstraints": {"$ref": "#/$defs/runtimeConstraints"},
        "testInputs": {"$ref": "#/$defs/testInputs"},
        "testImageDependencies": {"type": "array", "items": {"$ref": "#/$defs/testImageDependency"}},
        "testResults": {"type": "array", "items": {"$ref": "#/$defs/testResult"}},
        "testOutputArchive": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"const": "test-outputs.tar"}, "digest": {"$ref": "#/$defs/digest"}}},
        "sbom": {"type": "object", "additionalProperties": false, "required": ["digest", "spdxVersion"], "properties": {"digest": {"$ref": "#/$defs/digest"}, "spdxVersion": {"const": "SPDX-2.3"}}},
        "scans": {"type": "array", "items": {"$ref": "#/$defs/scan"}},
        "appliedExceptions": {"type": "array", "items": {"$ref": "#/$defs/appliedException"}},
        "appliedConfigurationExceptions": {"type": "array", "items": {"$ref": "#/$defs/appliedConfigurationException"}},
        "packageAssessment": {"$ref": "#/$defs/packageAssessment"},
        "setidInventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executables",
            "setgidDirectories",
            "declared"
          ],
          "properties": {
            "executables": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "mode",
                  "uid",
                  "gid",
                  "aliases"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "mode": {
                    "type": "string",
                    "pattern": "^0[0-7]{4}$"
                  },
                  "uid": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "gid": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^/"
                    }
                  }
                }
              }
            },
            "setgidDirectories": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/"
              }
            },
            "declared": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        },
        "appliedRuntimeRequirements": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["checkId", "requirement", "rationale", "owner", "reviewTrigger"],
            "properties": {
              "checkId": {"enum": ["DS-0002", "DS002", "AVD-DS-0002"]},
              "requirement": {"const": "root_requirement"},
              "rationale": {"type": "string", "minLength": 1},
              "owner": {"type": "string", "minLength": 1},
              "reviewTrigger": {"type": "string", "minLength": 1}
            }
          }
        },
        "payloadDigests": {"$ref": "#/$defs/digestArray"},
        "databaseDigest": {"$ref": "#/$defs/digest"},
        "databaseMetadata": {"$ref": "#/$defs/databaseMetadata"},
        "qualificationWindow": {"$ref": "#/$defs/qualificationWindow"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "transportMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "size"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?:records|layouts|reports|exports)/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "qualificationTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageId", "platform", "qualificationRecordDigest", "layoutDescriptor", "manifestDigest", "members", "totalBytes"],
      "properties": {
        "imageId": {"type": "string"},
        "platform": {"$ref": "#/$defs/platform"},
        "qualificationRecordDigest": {"$ref": "#/$defs/digest"},
        "layoutDescriptor": {"$ref": "#/$defs/descriptor"},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "members": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/transportMember"}},
        "totalBytes": {"type": "integer", "minimum": 0}
      }
    },
    "releaseCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageId", "repository", "requiredPlatforms", "acceptedPlatforms", "qualifications", "platformManifests", "subjectDescriptor", "candidateTag", "candidateNaming", "qualificationWindow"],
      "properties": {
        "imageId": {"type": "string"},
        "repository": {"type": "string"},
        "requiredPlatforms": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/platform"}},
        "acceptedPlatforms": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/platform"}},
        "qualifications": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["platform", "runId", "recordDigest", "payloadDigests"], "properties": {"platform": {"$ref": "#/$defs/platform"}, "runId": {"type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"}, "recordDigest": {"$ref": "#/$defs/digest"}, "transportDigest": {"$ref": "#/$defs/digest"}, "payloadDigests": {"$ref": "#/$defs/digestArray"}}}},
        "qualificationWindow": {"$ref": "#/$defs/qualificationWindow"},
        "platformManifests": {"type": "object", "additionalProperties": {"$ref": "#/$defs/digest"}},
        "subjectDescriptor": {"$ref": "#/$defs/descriptor"},
        "candidateTag": {"type": "string", "pattern": "candidate\\.[0-9a-hjkmnp-tv-z]{26}"},
        "candidateNaming": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "runId", "sourceRevision", "tag"],
          "properties": {
            "version": {"type": ["string", "null"]},
            "runId": {"type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"},
            "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
            "tag": {"type": "string", "pattern": "candidate\\.[0-9a-hjkmnp-tv-z]{26}"}
          }
        }
      }
    },
    "registryPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["tagProtection", "candidateCleanup"],
      "properties": {
        "tagProtection": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "rationale", "owner"],
          "properties": {
            "mode": {"enum": ["required", "not-enforced"]},
            "rationale": {"type": ["string", "null"]},
            "owner": {"type": ["string", "null"]}
          },
          "if": {"properties": {"mode": {"const": "not-enforced"}}},
          "then": {"properties": {"rationale": {"type": "string", "pattern": "\\S"}, "owner": {"type": "string", "pattern": "\\S"}}},
          "else": {"properties": {"rationale": {"type": "null"}, "owner": {"type": "null"}}}
        },
        "candidateCleanup": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "owner", "procedure"],
          "properties": {
            "mode": {"enum": ["manual", "tag-expiration", "auto-prune"]},
            "owner": {"type": "string", "pattern": "\\S"},
            "procedure": {"type": "string", "pattern": "\\S"}
          }
        }
      }
    },
    "candidateAuthorization": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "expiresAt"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "expiresAt": {"type": "string", "format": "date-time"}
      }
    },
    "releaseVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "platformDigests", "releaseEnvironment", "builder", "signer", "evidence", "qualificationWindow", "candidateAuthorization", "registryPolicy"],
      "properties": {
        "candidateAuthorization": {"$ref": "#/$defs/candidateAuthorization"},
        "registryPolicy": {"$ref": "#/$defs/registryPolicy"},
        "subject": {"type": "object", "additionalProperties": false, "required": ["repository", "digest"], "properties": {"repository": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}},
        "platformDigests": {"type": "object", "additionalProperties": {"$ref": "#/$defs/digest"}},
        "qualificationWindow": {"$ref": "#/$defs/qualificationWindow"},
        "releaseEnvironment": {"type": "object", "additionalProperties": false, "required": ["hostArchitecture", "runId"], "properties": {"hostArchitecture": {"type": "string"}, "runId": {"type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"}, "ciContext": {"$ref": "#/$defs/ciContext"}}},
        "builder": {"$ref": "#/$defs/builderIdentity"},
        "signer": {"type": "object", "additionalProperties": false, "required": ["mode", "keyId"], "properties": {"mode": {"enum": ["managed-key", "kms", "hsm"]}, "keyId": {"type": "string", "minLength": 1}}},
        "evidence": {"type": "object", "additionalProperties": false, "required": ["platformQualifications", "scanResults", "sboms", "provenance", "candidateRecord"], "properties": {"platformQualifications": {"$ref": "#/$defs/digestArray"}, "scanResults": {"$ref": "#/$defs/digestArray"}, "sboms": {"$ref": "#/$defs/digestArray"}, "provenance": {"$ref": "#/$defs/digest"}, "candidateRecord": {"$ref": "#/$defs/digest"}}}
      }
    },
    "rescanResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "releaseRecordDigest", "platformManifests", "scanner", "databaseDigest", "databaseMetadata", "scope", "findings", "appliedExceptions", "triage", "previousResultDigest", "authoritative", "remediation"],
      "properties": {
        "sourceTreeDigest": {"$ref": "#/$defs/digest"},
        "releaseArchiveDigest": {"$ref": "#/$defs/digest"},
        "subject": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
        "releaseRecordDigest": {"$ref": "#/$defs/digest"},
        "platformManifests": {"type": "object", "additionalProperties": {"$ref": "#/$defs/digest"}},
        "scanResults": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["platform", "sbomDigest", "reportDigest"], "properties": {"platform": {"$ref": "#/$defs/platform"}, "sbomDigest": {"$ref": "#/$defs/digest"}, "reportDigest": {"$ref": "#/$defs/digest"}, "packageAssessment": {"$ref": "#/$defs/packageAssessment"}}}},
        "scanner": {"type": "string"},
        "databaseDigest": {"$ref": "#/$defs/digest"},
        "databaseMetadata": {"$ref": "#/$defs/databaseMetadata"},
        "scope": {"enum": ["sbom-vulnerabilities", "full-image"]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/rescanFinding"}},
        "appliedExceptions": {"type": "array", "items": {"$ref": "#/$defs/rescanAppliedException"}},
        "appliedConfigurationExceptions": {"type": "array", "items": {"$ref": "#/$defs/rescanAppliedConfigurationException"}},
        "appliedRuntimeRequirements": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["platform", "checkId", "requirement", "rationale", "owner", "reviewTrigger"],
            "properties": {
              "platform": {"$ref": "#/$defs/platform"},
              "checkId": {"enum": ["DS-0002", "DS002", "AVD-DS-0002"]},
              "requirement": {"const": "root_requirement"},
              "rationale": {"type": "string", "minLength": 1},
              "owner": {"type": "string", "minLength": 1},
              "reviewTrigger": {"type": "string", "minLength": 1}
            }
          }
        },
        "triage": {"type": "array", "items": {"$ref": "#/$defs/triageDecision"}},
        "previousResultDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "authoritative": {"type": "boolean"},
        "remediation": {"$ref": "#/$defs/remediation"}
      }
    }
  }
}
